<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <connectionStrings>
        <!-- SQL Server Express instance (confirmed working) -->
        <add name="EcoCashDB" 
             connectionString="Server=.\SQLEXPRESS;Database=EcoCashDB;Integrated Security=true;Connection Timeout=30;" 
             providerName="System.Data.SqlClient" />

        <!-- Alternative: LocalDB instance (if you prefer to use LocalDB instead) -->
        <!-- 
        <add name="EcoCashDB" 
             connectionString="Server=(localdb)\mssqllocaldb;Database=EcoCashDB;Integrated Security=true;Connection Timeout=30;" 
             providerName="System.Data.SqlClient" />
        -->
    </connectionStrings>

    <appSettings>
        <add key="DatabaseAutoInitialize" value="true" />
    </appSettings>
</configuration>